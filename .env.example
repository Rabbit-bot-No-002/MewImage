# ============================================================
# Docker Compose 基础设置
# ============================================================

# Docker Hub 镜像。需要固定版本时可改成 mewlab/mewimage:1.1.0
MEW_DOCKER_IMAGE=mewlab/mewimage:latest
MEW_CONTAINER_NAME=mew-image
# 该端口会映射到容器内部固定的 3000 端口。
MEW_HOST_PORT=3188
MEW_MEMORY_LIMIT=1g

# Compose 默认只监听本机，配合 Nginx/NPM/Caddy 使用更安全。
# 需要直接通过服务器 IP 访问时显式改为 0.0.0.0。
# 容器化 NPM 不能直接访问宿主机 127.0.0.1，应优先使用共享 Docker 网络。
MEW_HOST_BIND=127.0.0.1

# ============================================================
# 首次部署必须修改
# ============================================================

# 用于设备/IP 摘要和认证保护，必须使用固定强随机值。
# 生成命令：openssl rand -hex 32
MEW_AUTH_SECRET=

# 首个管理员初始化口令。首次注册管理员时填写，建议使用密码管理器生成。
# 生成命令：openssl rand -base64 32
MEW_ADMIN_TOKEN=

# 允许访问后端的网页来源，多个地址使用英文逗号分隔，末尾不要加 /。
# 公网 HTTPS 示例：https://img.example.com
# 直接通过服务器端口访问示例：http://你的服务器IP:3188
# 下方默认值同时兼容 Docker 本机访问和前端开发端口；正式上线应只保留真实站点地址。
MEW_ALLOWED_ORIGINS=http://127.0.0.1:3188,http://localhost:3188,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8080,http://localhost:8080

# ============================================================
# HTTPS 与反向代理
# ============================================================

# 正式 HTTPS 域名部署改为 true；直接使用 HTTP/IP 测试时保持 false。
MEW_SESSION_SECURE=false

# 只有后端无法绕过 Nginx/NPM 直接从公网访问时才能设为 true。
MEW_TRUST_PROXY_HEADERS=false

# 开启代理头信任时必须填写实际反向代理的 IP/CIDR；不匹配的连接仍使用直连 IP。
# Docker 同网络反代常见示例：172.16.0.0/12；请按实际网络缩小范围。
MEW_TRUSTED_PROXY_CIDRS=

# 是否允许通过初始化口令创建第一个管理员。
MEW_ALLOW_ADMIN_SETUP=true

# ============================================================
# 注册、登录与密码哈希限制
# ============================================================

# 同一浏览器设备最多成功注册账号数；0 表示关闭。
MEW_REGISTER_DEVICE_LIMIT=3

# 同一 IP 每 86400 秒最多尝试注册 10 次。
MEW_REGISTER_IP_LIMIT=10
MEW_REGISTER_WINDOW_SECONDS=86400

# 同一 IP 每 600 秒最多尝试登录 20 次。
MEW_LOGIN_IP_LIMIT=20
MEW_LOGIN_WINDOW_SECONDS=600

# 同一账号连续输错 5 次密码后锁定 300 秒。
MEW_LOGIN_FAILURE_LIMIT=5
MEW_LOGIN_LOCK_SECONDS=300

# 同时运行的 Argon2 密码哈希/校验任务数，小型服务器建议保持 2。
MEW_AUTH_HASH_CONCURRENCY=2

# ============================================================
# 游客代理与第三方服务商
# ============================================================

# 游客可使用瞬时生成代理，但工作区和图片不会写入服务器存储。
MEW_GUEST_PROXY=true

# 同一游客 IP 的活动任务与图片代理并发上限。并发上限始终生效。
# 旧版 *_CONCURRENCY 名称仍可读取，新部署统一使用下列名称。
MEW_GUEST_GENERATION_MAX_ACTIVE=4
MEW_GUEST_IMAGE_FETCH_MAX_ACTIVE=2

# 同一游客 IP 在统计窗口内的调用上限；设为 0 可关闭频率限制。
# 旧版 MEW_GUEST_IMAGE_RATE_LIMIT 仍可读取。
MEW_GUEST_GENERATION_RATE_LIMIT=30
MEW_GUEST_IMAGE_FETCH_RATE_LIMIT=120
MEW_GUEST_RATE_WINDOW_SECONDS=600

# 高级 CustomHttp 服务商固定仅向已审批登录用户开放，不能通过环境变量放宽。

# 默认允许公网第三方中转站，同时拒绝本机、私网和链路本地地址。
# 若只允许固定上游，可设为 true，并填写 MEW_TRUSTED_HOSTS。
MEW_ENFORCE_HOST_WHITELIST=false
MEW_TRUSTED_HOSTS=

# 上游默认必须使用 HTTPS。只应在完全了解明文传输风险时开启 HTTP。
MEW_ALLOW_HTTP_UPSTREAM=false

# 仅供本机开发：允许显式访问 127.0.0.1、::1 或 localhost。
# 只有后端自身也监听环回地址时才生效；不会放开 10.x/172.16-31.x/192.168.x。
# 明文环回上游还必须同时开启 MEW_ALLOW_HTTP_UPSTREAM。生产部署请保持 false。
MEW_ALLOW_LOOPBACK_UPSTREAM=false

# 仅供本机开发：跳过生成、图片下载（含重定向）的主机与解析 IP 安全检查。
# 可用于局域网上游或代理软件 Fake-IP DNS；仅在后端监听环回地址时生效。
# HTTP 仍需 MEW_ALLOW_HTTP_UPSTREAM=true；生产部署请保持 false。
MEW_DEV_BYPASS_UPSTREAM_SSRF=false

# 留空时根据容器/主机内存自动计算，1 GiB 容器通常得到约 409 MiB。
MEW_PROXY_MEMORY_BUDGET_MIB=

# ============================================================
# 登录用户图片存储
# ============================================================

# local：保存到宿主机 ./data/assets，个人部署推荐。
# s3：使用下方 S3 兼容对象存储。
# disabled：禁用云端图片存储，游客本地模式仍可使用。
MEW_ASSET_STORE=local

# 单个云端图片与每个已审批用户的默认存储上限；用户超额后仍可读取和删除。
MEW_MAX_ASSET_MIB=64
MEW_USER_ASSET_QUOTA_MIB=5120

# 模板广场使用独立的公共资源命名空间和总配额（包含派生缩略图）；达到上限后管理员仍可删除旧模板。
MEW_GALLERY_ASSET_QUOTA_MIB=5120
MEW_GALLERY_ASSET_QUOTA_COUNT=20000

# 上述新增安全配置同时兼容 MEW_IMAGE_* 命名，便于旧部署平滑迁移：
# MEW_IMAGE_ENABLE_GUEST_PROXY、MEW_IMAGE_GUEST_GENERATION_MAX_ACTIVE、
# MEW_IMAGE_GUEST_IMAGE_FETCH_MAX_ACTIVE、MEW_IMAGE_GUEST_GENERATION_RATE_LIMIT、
# MEW_IMAGE_GUEST_IMAGE_FETCH_RATE_LIMIT、MEW_IMAGE_GUEST_RATE_WINDOW_SECONDS、
# MEW_IMAGE_ALLOW_HTTP_UPSTREAM、MEW_IMAGE_ALLOW_LOOPBACK_UPSTREAM、
# MEW_IMAGE_PROXY_MEMORY_BUDGET_MIB、
# MEW_IMAGE_MAX_ASSET_MIB、MEW_IMAGE_USER_ASSET_QUOTA_MIB、
# MEW_IMAGE_TRUSTED_PROXY_CIDRS、MEW_IMAGE_ENFORCE_PROVIDER_HOST_WHITELIST。
# 同一配置不要同时填写 MEW_* 与兼容别名；主名称优先。

# 只有 MEW_ASSET_STORE=s3 时才需要填写。
MEW_S3_BUCKET=
MEW_S3_REGION=us-east-1
MEW_S3_ENDPOINT=
MEW_S3_ACCESS_KEY=
MEW_S3_SECRET_KEY=
